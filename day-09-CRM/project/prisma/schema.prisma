generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Upload {
  id           Int           @id @default(autoincrement())
  filename     String
  totalRows    Int           @default(0)
  insertedRows Int           @default(0)
  failedRows   Int           @default(0)
  createdAt    DateTime      @default(now())
  status       UploadStatus  @default(PROCESSING)
  updatedAt    DateTime      @updatedAt
  dealers      Dealer[]
  errors       UploadError[]
}

model Dealer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String   @unique
  email       String
  city        String
  state       String
  creditLimit Decimal  @default(0)
  createdAt   DateTime @default(now())
  uploadId    Int
  updatedAt   DateTime @updatedAt
  upload      Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@index([phone])
  @@index([email])
}

model UploadError {
  id         Int      @id @default(autoincrement())
  rowNumber  Int
  columnName String
  message    String
  value      String
  createdAt  DateTime @default(now())
  uploadId   Int
  upload     Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
}

enum UploadStatus {
  PROCESSING
  COMPLETED
  FAILED
}
